# ── Database ──────────────────────────────────────────────────────────────────
# DB_TYPE: "sqlite" (default) or "postgres"
# DB_TYPE=sqlite

# SQLite: path to the data directory (default: ./data)
# DATA_DIR=./data

# PostgreSQL: required when DB_TYPE=postgres
# POSTGRES_PASSWORD=change-me-to-a-strong-random-password
# POSTGRES_USER=montly           # optional, defaults to "montly"
# DATABASE_URL=postgres://montly:change-me@localhost:5432/montly

# ── Auth ──────────────────────────────────────────────────────────────────────
# SESSION_SECRET: HMAC signing key for session cookies.
# If unset, a random key is generated each restart (sessions are lost on restart).
# Generate a good value with: openssl rand -base64 32
# SESSION_SECRET=

# ADMIN_USERNAME / ADMIN_PASSWORD: used ONCE on first startup when no users exist.
# After the admin account is created these env vars are ignored.
# ADMIN_PASSWORD must be at least 8 characters — change it before deploying.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-at-least-8-chars

# TRUST_PROXY_HEADERS: set to "true" ONLY when montly is behind a trusted
# reverse proxy (e.g. nginx, Traefik) that sets X-Forwarded-For.
# Leaving this false prevents IP spoofing of the rate limiter.
# TRUST_PROXY_HEADERS=false

# SECURE_COOKIES: set to "true" when serving over HTTPS.
# Adds the Secure flag to session cookies and HSTS header.
# SECURE_COOKIES=true

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=8080

# ── OpenID Connect / SSO (optional) ──────────────────────────────────────────
# Set OIDC_ISSUER to enable "Sign in with SSO". The issuer must serve a
# /.well-known/openid-configuration discovery document (Keycloak, Authentik,
# Auth0, Okta, Google, Entra ID, etc.).
# OIDC_ISSUER=https://sso.example.com/realms/montly
# OIDC_CLIENT_ID=montly
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URL=https://montly.example.com/api/auth/oidc/callback
#
# Optional:
# OIDC_PROVIDER_NAME=Company SSO      # button label on the login screen (default: SSO)
# OIDC_SCOPES=profile email           # extra scopes; "openid" is always included
# OIDC_USERNAME_CLAIM=preferred_username   # claim used to derive the username
# OIDC_GROUPS_CLAIM=groups             # claim holding the user's groups
# OIDC_ADMIN_GROUP=montly-admins       # membership grants admin (synced every login)
# OIDC_ALLOW_SIGNUP=true               # auto-create users on first SSO login
# OIDC_LINK_BY_EMAIL=true              # link to an existing user by verified email
# OIDC_LINK_BY_USERNAME=true           # link to an existing user by username
# DISABLE_PASSWORD_LOGIN=false         # SSO-only (ignored unless OIDC is configured)

# ── MCP Server (optional, separate container) ────────────────────────────────
# See mcp-server/README.md for setup. The MCP server runs as its own service
# in docker-compose and needs these env vars set on that service, not here.
# MONTLY_URL=http://montly:8080
# MONTLY_TOKEN=mt_your_token_here
# MCP_PORT=8081
